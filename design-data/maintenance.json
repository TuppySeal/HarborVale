  "wear_rules": {
    "distance_source": "actual_unpaused_driven_ground_path_metres_excluding_teleport_tow_recovery",
    "condition_loss_formula": "pending_fraction += distance_m/1000 * wear_points_per_km * component_stress; loss=floor(pending_fraction); condition=max(0,condition-loss); pending_fraction-=loss",
    "persisted_fraction_fields": "vehicle.wear_fraction_by_component; vehicle.odometer_fraction_m",
    "base_stress_multiplier": 1,
    "output_stress": {
      "components": [
        "engine",
        "cooling",
        "transmission"
      ],
      "ratio": "installed_healthy_peak_kw/stock_healthy_peak_kw",
      "coefficient": 0.25,
      "maximum_multiplier": 1.35
    },
    "high_rpm_stress": {
      "component": "engine",
      "rpm_fraction_threshold": 0.97,
      "throttle_threshold": 0.8,
      "multiplier": 1.8
    },
    "hard_braking_stress": {
      "component": "brakes",
      "brake_input_threshold": 0.7,
      "maximum_additional_multiplier": 0.75
    },
    "wheelspin_stress": {
      "component": "tires",
      "absolute_slip_ratio_threshold": 0.35,
      "throttle_threshold": 0.6,
      "multiplier": 2
    },
    "combined_component_multiplier_cap": 3,
    "hot_engine_stress": {
      "component": "engine",
      "thermal_load_threshold": 8000,
      "maximum_additional_multiplier": 0.75
    },
    "offline_wear": false,
    "paused_wear": false,
    "stationary_rev_wear": false,
    "transaction_commit_includes_wear_and_odometer": true,
    "free_roam_autosave_interval_seconds": 30
